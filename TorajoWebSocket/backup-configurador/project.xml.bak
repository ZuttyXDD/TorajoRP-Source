<?xml version="1.0" encoding="utf-8"?>
<project>
    <app title="TorajoRP" file="TorajoRP" package="com.torajo.arthur" version="0.8.0" company="Arthur" />
<config:android
    minimum-sdk-version="24"
    target-sdk-version="36"
    build-tools-version="36.0.0"
    gradle-version="8.11.1"
    gradle-plugin="8.9.1"
/>
    <meta title="TorajoRP: Mobile" description="TorajoRP para Android" />
    <window width="1280" height="720" background="#000000" />
    <window orientation="landscape" />
    <source path="source" />
    <haxelib name="flixel" />
    <haxelib name="openfl-websocket" />
    <section if="cpp">
        <haxelib name="extension-admob" if="mobile" />
    </section>
    <setenv name="ADMOB_APPID" value="ca-app-pub-5706411111888531~5664907448" if="android" />
    <haxedef name="FLX_NO_DEBUG" if="release" />
    <assets path="../Assets" rename="Assets" />
    <icon path="../art/Android/game-icon.png" />
    <set name="BUILD_DIR" value="export" />

<certificate
    path="C:/Users/Arthur Fernandes/Documents/TorajoRP-upload-key.jks"
    alias="torajorp-upload"
    if="android"
/>

</project>
