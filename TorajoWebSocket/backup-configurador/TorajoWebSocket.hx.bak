package;


import lime.system.CFFI;
import lime.system.JNI;


class TorajoWebSocket {
	
	
	public static function sampleMethod (inputValue:Int):Int {
		
		#if android
		
		var resultJNI = torajowebsocket_sample_method_jni(inputValue);
		var resultNative = torajowebsocket_sample_method(inputValue);
		
		if (resultJNI != resultNative) {
			
			throw "Fuzzy math!";
			
		}
		
		return resultNative;
		
		#else
		
		return torajowebsocket_sample_method(inputValue);
		
		#end
		
	}
	
	
	private static var torajowebsocket_sample_method = CFFI.load ("torajowebsocket", "torajowebsocket_sample_method", 1);
	
	#if android
	private static var torajowebsocket_sample_method_jni = JNI.createStaticMethod ("org.haxe.extension.TorajoWebSocket", "sampleMethod", "(I)I");
	#end
	
	
}